# Sanity project — copy this file to `.env.local` to override the committed
# public defaults. Never commit `.env.local` or a read token.

# Publicly exposed to the browser (safe — these identify the dataset, not secrets).
NEXT_PUBLIC_SANITY_PROJECT_ID="vaq3w914"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-01"

# Optional: server-only read token for previewing drafts / private datasets.
# Leave blank for a public dataset. Never prefix this with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=""
